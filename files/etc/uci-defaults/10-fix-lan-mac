#!/bin/sh

find_cpu_serial() {
	if [ -f /sys/class/net/eth0/address ]; then
		cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':'
		return 0
	fi
	return 1
}

derive_mac() {
	local serial="$1" h
	h="$(printf '%s' "$serial" | sha256sum | awk '{print $1}')"
	[ -n "$h" ] || return 1
	
	# Безопасно режем хэш напрямую через cut без проверки длины строки
	printf '02:%s:%s:%s:%s:%s\n' \
		"$(printf '%s' "$h" | cut -c1-2)" \
		"$(printf '%s' "$h" | cut -c3-4)" \
		"$(printf '%s' "$h" | cut -c5-6)" \
		"$(printf '%s' "$h" | cut -c7-8)" \
		"$(printf '%s' "$h" | cut -c9-10)"
}

set_bridge_mac() {
	local mac="$1"
	
	# Намертво привязываем вычисленный адрес к свитчу и логической сети
	uci set network.eth0=device
	uci set network.eth0.name='eth0'
	uci set network.eth0.macaddr="$mac"
	uci set network.lan.macaddr="$mac"
	uci commit network
	return 0
}

SERIAL="$(find_cpu_serial)"
[ -n "$SERIAL" ] || exit 1

MAC="$(derive_mac "$SERIAL")"
[ -n "$MAC" ] || exit 1

set_bridge_mac "$MAC" || exit 1
exit 0
