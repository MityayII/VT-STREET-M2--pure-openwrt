#!/bin/sh

# Функция проверки валидности MAC (чтобы отсечь FFFF и нули)
mac_valid() {
	case "$1" in
		"00:00:00:00:00:00"|"FF:FF:FF:FF:FF:FF"|"") return 1 ;;
		*) return 0 ;;
	esac
}

# 1. Пытаемся нативно прочитать MAC, который ядро само вытащило из DTS/Factory
MAC=$(cat /sys/class/net/eth0/address 2>/dev/null)

# 2. Если там лежат FFFF (как в нашем случае) — включаем генератор по CPU boot_id
if ! mac_valid "$MAC"; then
	SERIAL="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
	if [ -n "$SERIAL" ]; then
		# Генерируем стабильный MAC через md5sum (он на 100% встроен в BusyBox)
		hash="$(printf '%s' "$SERIAL" | md5sum | awk '{print $1}')"
		tail="$(printf '%s' "$hash" | cut -c1-10)"
		MAC="02:$(printf '%s' "$tail" | cut -c1-2):$(printf '%s' "$tail" | cut -c3-4):$(printf '%s' "$tail" | cut -c5-6):$(printf '%s' "$tail" | cut -c7-8):$(printf '%s' "$tail" | cut -c9-10)"
	else
		# Аварийный бэкап, если boot_id недоступен
		MAC="02:EB:D7:A1:B2:C3"
	fi
fi

# 3. Жестко фиксируем MAC-адрес на домашнем мосту br-lan
idx=0
while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
	if [ "$(uci -q get "network.@device[$idx].name")" = "br-lan" ]; then
		uci set "network.@device[$idx].macaddr=$MAC"
		uci set "network.lan.macaddr=$MAC"
		uci commit network
		break
	fi
	idx=$((idx + 1))
done

exit 0
