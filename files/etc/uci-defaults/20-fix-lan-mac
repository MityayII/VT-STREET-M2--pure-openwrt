#!/bin/sh

# Подтягиваем нативные системные библиотеки OpenWrt
. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh

# 1. Первоочередная проверка родного MAC в Factory
MAC=$(mtd_get_mac_binary Factory 40)

# Если в Factory чисто и адрес валидный — мы просто пропускаем все аварийные шаги
if [ -n "$MAC" ] && [ "$MAC" != "00:00:00:00:00:00" ] && [ "$MAC" != "ff:ff:ff:ff:ff:ff" ]; then
	logger -t "mac-generator" "Valid factory MAC found in MTD. Using it as-is."
else
	# =========================================================================
	# ШАГ 2: АВАРИЙНЫЙ РЕЖИМ (Factory пуст) — ИЩЕМ КРЕМНИЕВЫЙ ПАСПОРТ ETH0
	# =========================================================================
	logger -t "mac-generator" "Factory MAC is empty or invalid. Checking silicon eth0..."
	
	# Благодаря каноничному индексу 20 интерфейс eth0 уже гарантированно создан ядром!
	serial=$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')
	
	# ЮВЕЛИРНЫЙ ФИЛЬТР: Если eth0 пуст или ядро выплюнуло свой временный дефолт 200802...
	if [ -z "$serial" ] || [ "${serial##200802}" != "$serial" ]; then
		logger -t "mac-generator" "eth0 contains kernel default. Generating safe permanent fallback seed..."
		
		# БЕЗОПАСНЫЙ И ВЕЧНЫЙ ФОЛЛБЕК: Генерируем статичный хэш на основе имени модели.
		# Не требует энтропии (не зависнет в preinit) и не изменится при сбросе настроек роутера.
		serial=$(printf 'VT-STREET-M2-permanent-safe-fallback' | sha256sum | awk '{print $1}')
	fi
	
	# Нарезаем из проверенного серийника вечный адрес. Префикс 02 зашит намертво текстом!
	MAC="02:$(echo "$serial" | cut -c3-4):$(echo "$serial" | cut -c5-6):$(echo "$serial" | cut -c7-8):$(echo "$serial" | cut -c9-10):$(echo "$serial" | cut -c11-12)"
fi

# =========================================================================
# ШАГ 3: АВТОМАТИЧЕСКАЯ РАСКАТКА ОДНОГО MAC НА ВСЕ ИНТЕРФЕЙСЫ LAN
# =========================================================================
# Нативно отдаем адрес системе. Она сама через board.json красиво и ровно
# привяжет его и к родительскому eth0, и к br-lan, и к порту lan1, не трогая модем.
ucidef_set_interface_macaddr "lan" "$MAC"

board_config_flush
exit 0
