#!/bin/sh

# Подтягиваем нативные системные библиотеки OpenWrt
. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh

TAG="mac-generator"

log()
{
	echo "<4>[$TAG]: $*" > /dev/kmsg
}

# ШАГ 1: Пробуем штатный метод чтения MAC из Factory
MAC=$(mtd_get_mac_binary Factory 40)

# Если в Factory чисто и адрес валидный — мы просто пропускаем аварийные шаги
if [ -n "$MAC" ] && [ "$MAC" != "00:00:00:00:00:00" ] && [ "$MAC" != "ff:ff:ff:ff:ff:ff" ] && [ "${MAC##200802}" = "$MAC" ]; then
	log "Valid factory MAC present in MTD partition; fallback not needed"
	exit 0
fi

# =========================================================================
# ШАГ 2: АВАРИЙНЫЙ РЕЖИМ — ЦИКЛ КРЕМНИЕВОЙ ОПТИМИЗАЦИИ (ДО 15 СЕКУНД)
# =========================================================================
log "Factory MAC is invalid or missing. Triggering persistent hardware loop..."

h=""
i=0
while [ "$i" -lt 15 ]; do
	log "Cycle такт $((i + 1)): Checking /dev/mtd2 status..."
	if [ -c "/dev/mtd2" ] || [ -c "/dev/mtdblock2" ] || [ -f "/proc/mtd" ]; then
		# Считываем первые 64 байта уникальных радио-калибровок чипа
		h=$(dd if=/dev/mtd2 bs=1 count=64 2>/dev/null | sha256sum | awk '{print $1}')
		log "Cycle такт $((i + 1)): Generated hash payload -> $h"
		
		# Отсекаем ложный пустой хэш SHA-256 (пока флешка спит)
		if [ -n "$h" ] && [ "$h" != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]; then
			log "Cycle такт $((i + 1)): SUCCESS! Valid silicon data block locked. Breaking loop."
			break
		fi
	else
		log "Cycle такт $((i + 1)): WARNING - MTD2 block device not initialized by kernel yet."
	fi
	sleep 1
	i=$((i + 1))
done

# Если чтение флешки сорвалось или вернуло пустой хэш — страхуемся статичной константой модели
if [ -z "$h" ] || [ "$h" = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]; then
	log "MTD2 partition read timeout; fallback to hardcoded safe seed"
	h=$(printf 'VT-STREET-M2-PERMANENT-STATIC-CORE-SAFE-SEED' | sha256sum | awk '{print $1}')
fi

# Нарезаем вечный адрес. Локальный префикс 02 зашит намертво текстом!
MAC="02:$(printf '%s' "$h" | cut -c3-4):$(printf '%s' "$h" | cut -c5-6):$(printf '%s' "$h" | cut -c7-8):$(echo "$h" | cut -c9-10):$(echo "$h" | cut -c11-12)"

# =========================================================================
# ШАГ 3: ПРИНУДИТЕЛЬНЫЙ UCI-НАКАТ НАПРЯМУЮ В КОНФИГУРАТОР СЕТИ
# =========================================================================
log "Applying permanent unique LAN MAC via direct UCI commit: $MAC"

# Нативно объявляем адрес в board.json (для LuCI статус-панелей)
ucidef_set_interface_macaddr "lan" "$MAC"
board_config_flush

# Бронебойная прямая запись: пишем МАК жестко в конфиг интерфейса lan и девайса br-lan.
# Это избавит нас от необходимости крутить сложные циклы поиска индексов секций!
uci -q set network.lan.macaddr="$MAC"
uci -q set network.br_lan.macaddr="$MAC"
uci -q commit network

# Перезапускаем сетевую службу на лету, чтобы сбросить случайный MAC ядра
/etc/init.d/network restart

exit 0
