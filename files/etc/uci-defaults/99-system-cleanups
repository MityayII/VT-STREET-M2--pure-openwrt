#!/bin/sh

# === 1. УСТАНОВКА ЧАСОВОГО ПОЯСА И NTP СЕРВЕРОВ РФ ===
# Жестко указываем нулевой индекс для анонимного массива системы
uci set system.@system[0].zonename='Europe/Moscow'
uci set system.@system[0].timezone='<+03>-3'
uci set system.ntp.enabled='1'
uci set system.ntp.enable_server='0'
uci -q delete system.ntp.server
uci add_list system.ntp.server='0.ru.pool.ntp.org'
uci add_list system.ntp.server='1.ru.pool.ntp.org'
uci add_list system.ntp.server='pool.ntp.org'
uci commit system

# Возвращаем имя маршрутизатора вместо дефолтного OpenWrt
uci set system.@system[0].hostname='VT-STREET-M2'
uci commit system

# Запускаем бесконечный фоновый системный демон синхронизации времени
/etc/init.d/sysntpd restart

# === 2. ЖЕСТКОЕ ОТКЛЮЧЕНИЕ IPV6 НА УРОВНЕ ЯДРА И СЛУЖБ ОС ===
echo "net.ipv6.conf.all.disable_ipv6=1" >> /etc/sysctl.conf
echo "net.ipv6.conf.default.disable_ipv6=1" >> /etc/sysctl.conf
echo "net.ipv6.conf.lo.disable_ipv6=1" >> /etc/sysctl.conf
sysctl -p /etc/sysctl.conf 2>/dev/null

uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci commit dhcp
/etc/init.d/odhcpd restart 2>/dev/null

uci -q delete network.globals.ula_prefix
uci commit network

# === 3. НАСТРОЙКА LED-ИНДИКАЦИИ СЕТИ ИНТЕРНЕТА (По канону Vertell) ===
# Удаляем старое правило, чтобы конфигурация не задваивалась
uci -q delete system.led_net

# Прописываем точные параметры под green:wan для сетевой карты модема eth1
uci set system.led_net=led
uci set system.led_net.name='net'
uci set system.led_net.sysfs='green:wan'
uci set system.led_net.trigger='netdev'
uci set system.led_net.dev='eth1'
uci add_list system.led_net.mode='link'
uci add_list system.led_net.mode='tx'
uci add_list system.led_net.mode='rx'
uci commit system

# Перезапускаем службу светодиодов для применения параметров
/etc/init.d/led restart 2>/dev/null

exit 0
