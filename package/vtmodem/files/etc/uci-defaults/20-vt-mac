#!/bin/sh

# Подтягиваем системные библиотеки
. /lib/functions/system.sh

TAG="mac-force"

log()
{
	echo "<4>[$TAG]: $*" > /dev/kmsg
}

# ШАГ 1: Извлекаем вечный стабильный хэш кремния
h=$(head -c 64 /dev/mtd2 2>/dev/null | sha256sum | awk '{print $1}')

# Страховка на случай микросекундного сна чипа флеш-памяти
if [ -z "$h" ] || [ "$h" = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]; then
	h=$(printf 'VT-STREET-M2-PERMANENT-CORE-SAFE-SEED' | sha256sum | awk '{print $1}')
fi

# Нарезаем наш уникальный вечный паспорт
MAC="02:$(echo "$h" | cut -c3-4):$(echo "$h" | cut -c5-6):$(echo "$h" | cut -c7-8):$(echo "$h" | cut -c9-10):$(echo "$h" | cut -c11-12)"

log "FORCING HARDWARE INTERFACES TO STABLE MAC: $MAC"

# =========================================================================
# ШАГ 2: ПРЯМАЯ ХИРУРГИЧЕСКАЯ КОРРЕКЦИЯ ЖИВЫХ ИНТЕРФЕЙСОВ ЯДРА
# =========================================================================

# 1. Силой сдираем случайный мусор netifd с физического корня процессора
ip link set dev eth0 down 2>/dev/null
ip link set dev eth0 address "$MAC" 2>/dev/null
ip link set dev eth0 up 2>/dev/null

# 2. Силой сдираем случайный мусор netifd с виртуального моста br-lan
ip link set dev br-lan down 2>/dev/null
ip link set dev br-lan address "$MAC" 2>/dev/null
ip link set dev br-lan up 2>/dev/null

# 3. Дублируем в UCI, чтобы LuCI и веб-морда ровно подхватили цифры в статус-бар
uci set network.lan.macaddr="$MAC"
idx=0
while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
	if [ "$(uci -q get "network.@device[$idx].name")" = "br-lan" ]; then
		uci set "network.@device[$idx].macaddr=$NEW_MAC"
		break
	fi
	idx=$((idx + 1))
done
uci commit network

log "Hardware interfaces configuration successfully locked to $MAC"
exit 0
